rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // All client SDK access is denied. Uploads go through /api/upload
    // (Admin SDK, token-verified, path-validated) and reads use the signed
    // URLs that route returns. This keeps children's documents (birth
    // certificates, physicals) and coach clearances private.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
