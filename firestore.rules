
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             getUserData().role == 'Admin';
    }

    function isCoach() {
      let data = getUserData();
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             (data.role == 'Coach' ||
              (data.role == 'Admin' && data.get('isAlsoCoach', false) == true));
    }

    // Support for collection group queries
    match /{path=**}/players/{playerId} {
      allow read: if isSignedIn();
    }
    
    match /{path=**}/enrollments/{enrollmentId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/clearances/{clearanceId} {
      allow read: if isSignedIn();
    }
    
    match /{path=**}/rsvps/{rsvpId} {
      allow read, write: if isSignedIn();
    }

    match /userProfiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isUser(userId) || isAdmin();
      allow update: if isUser(userId) || isAdmin();
      allow delete: if false;

      match /clearances/{clearanceId} {
        allow read: if isUser(userId) || isAdmin();
        allow create: if isUser(userId) || isAdmin();
        allow update: if isUser(userId) || isAdmin();
        allow delete: if isUser(userId) || isAdmin();
      }

      match /players/{playerId} {
        allow read: if isSignedIn();
        allow create: if isUser(userId) || isAdmin();
        allow update: if isUser(userId) || isAdmin();
        allow delete: if isUser(userId) || isAdmin();
      }

      match /enrollments/{enrollmentId} {
        allow read: if isSignedIn();
        allow create: if isUser(userId) || isAdmin();
        allow update: if isUser(userId) || isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['payment_status', 'paymentStatus', 'stripe_payment_id', 'updatedAt']);
        allow delete: if isUser(userId) || isAdmin();
      }
    }

    match /seasons/{seasonId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /divisions/{divisionId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    match /teams/{teamId} {
      allow get, list: if isSignedIn(); 
      allow create: if isAdmin();
      allow update: if isAdmin() || (resource != null && request.auth.uid == resource.data.coach_uid);
      allow delete: if isAdmin();

      match /games/{gameId} {
        allow get, list: if isSignedIn();
        allow create: if isCoach() || isAdmin();
        allow update: if isCoach() || isAdmin();
        allow delete: if isCoach() || isAdmin();

        match /rsvps/{rsvpId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if isSignedIn() || isAdmin();
        }
      }

      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderUserId;
      }
    }
  }
}
