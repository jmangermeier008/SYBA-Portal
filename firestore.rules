rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function isSiteAdmin() {
      let data = getUserData();
      let roles = data.get('roles', []);
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             roles.hasAny(['Site Admin']);
    }

    function isAdmin() {
      let data = getUserData();
      let roles = data.get('roles', []);
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             (roles.size() > 0 ? roles.hasAny(['Admin']) : data.role == 'Admin');
    }

    function isBoardMember() {
      let data = getUserData();
      let roles = data.get('roles', []);
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             (roles.size() > 0
               ? roles.hasAny(['Board Member', 'Admin', 'Site Admin'])
               : data.role == 'Admin');
    }

    function isBoardMemberForSport(sport) {
      let data = getUserData();
      let roles = data.get('roles', []);
      let sportRoles = data.get('sportRoles', {});
      let rolesForSport = sportRoles.get(sport, []);
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             (roles.hasAny(['Site Admin']) || rolesForSport.hasAny(['Board Member', 'Admin']));
    }

    function isCoach() {
      let data = getUserData();
      let roles = data.get('roles', []);
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             (roles.size() > 0
               ? roles.hasAny(['Coach', 'Admin'])
               : (data.role == 'Coach' ||
                  (data.role == 'Admin' && data.get('isAlsoCoach', false) == true)));
    }

    // ---------------------------------------------------------------------------
    // Collection group rules — must be at the top level
    // ---------------------------------------------------------------------------

    // Players: board members use collectionGroup for compliance; parents use direct path
    // Secondary parents can read players linked to them via secondaryParentId
    match /{path=**}/players/{playerId} {
      allow read: if isBoardMember() ||
        (isSignedIn() && resource.data.secondaryParentId == request.auth.uid);
    }

    // Enrollments: board members can read all; parents can read their own (filtered by parentUserId)
    match /{path=**}/enrollments/{enrollmentId} {
      allow read: if isBoardMember() ||
        (isSignedIn() && resource.data.parentUserId == request.auth.uid);
    }

    match /{path=**}/clearances/{clearanceId} {
      allow read: if isBoardMember();
    }

    match /{path=**}/rsvps/{rsvpId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.parentUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.parentUserId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.parentUserId == request.auth.uid;
    }

    // ---------------------------------------------------------------------------
    // User Profiles
    // ---------------------------------------------------------------------------

    match /userProfiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isUser(userId) || isAdmin() || isSiteAdmin();
      // Users can update their own profile but cannot change their own role.
      // Role changes require Admin or Site Admin.
      allow update: if (isUser(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles'])
        ) || isAdmin() || isSiteAdmin();
      allow delete: if isAdmin() || isSiteAdmin();

      match /clearances/{clearanceId} {
        allow read: if isUser(userId) || isAdmin();
        allow create: if isUser(userId) || isAdmin();
        allow update: if isUser(userId) || isAdmin();
        allow delete: if isUser(userId) || isAdmin();
      }

      match /players/{playerId} {
        allow read: if isUser(userId) || isBoardMember() ||
          (isSignedIn() && resource.data.secondaryParentId == request.auth.uid);
        allow create: if isUser(userId) || isAdmin();
        allow update: if isUser(userId) || isAdmin() ||
          (isSignedIn() && resource.data.secondaryParentId == request.auth.uid);
        allow delete: if isUser(userId) || isAdmin();
      }

      match /enrollments/{enrollmentId} {
        allow read: if isUser(userId) || isBoardMember();
        allow create: if isUser(userId) || isAdmin();
        allow update: if (
          // Parent can update their own enrollment but not payment status, sport, or admin-only equipment fields
          (isUser(userId) &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['payment_status', 'paymentStatus', 'stripe_payment_id', 'footballEquipment', 'sport']))
          ) ||
          // Admins have full update access
          isAdmin() ||
          // Board members (sport-scoped) can update equipment fields only
          (isBoardMemberForSport(resource.data.sport) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['footballEquipment']));
        allow delete: if isUser(userId) || isBoardMember();
      }
    }

    // ---------------------------------------------------------------------------
    // Seasons & Divisions
    // ---------------------------------------------------------------------------

    match /seasons/{seasonId} {
      allow get, list: if true; // public — home page shows registration banner
      allow create: if isBoardMember() &&
        request.resource.data.sport is string;
      allow update, delete: if isBoardMember();

      match /divisions/{divisionId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isBoardMember();
      }
    }

    // ---------------------------------------------------------------------------
    // Fields — Site Admin manages; all signed-in users read
    // ---------------------------------------------------------------------------

    match /fields/{fieldId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isBoardMember();
    }

    // ---------------------------------------------------------------------------
    // Games & Practices — board members manage; all signed-in users read
    // ---------------------------------------------------------------------------

    match /games/{gameId} {
      allow get, list: if true; // public — home page shows this week's schedule
      allow create: if isBoardMember() &&
        request.resource.data.sport is string;
      allow update: if isBoardMember() &&
        request.resource.data.sport is string;
      allow delete: if isBoardMember();
    }

    match /teams/{teamId} {
      allow get, list: if isSignedIn();
      allow create: if isBoardMember() &&
        request.resource.data.sport is string;
      allow update: if isBoardMember() || (resource != null && request.auth.uid == resource.data.coach_uid);
      allow delete: if isBoardMember();

      match /games/{gameId} {
        allow get, list: if isSignedIn();
        allow create: if isCoach() || isBoardMember();
        allow update: if isBoardMember() ||
          (isCoach() &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['homeScore', 'awayScore', 'status', 'attendance',
                       'cancelled', 'cancellationReason', 'updatedAt']));
        allow delete: if isBoardMember();

        match /rsvps/{rsvpId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.parentUserId == request.auth.uid;
          allow update: if isSignedIn() && resource.data.parentUserId == request.auth.uid;
          allow delete: if (isSignedIn() && resource.data.parentUserId == request.auth.uid) || isBoardMember();
        }
      }
    }

    // ---------------------------------------------------------------------------
    // Concession Slots
    //
    // Board members: full CRUD.
    // Signed-in users: read all slots (to see availability).
    // Parents: may only update the `signups` array field via transaction.
    //   All other fields (capacity, dates, etc.) are board-member-only.
    // ---------------------------------------------------------------------------

    match /concessionSlots/{slotId} {
      allow get, list: if isSignedIn();
      allow create, delete: if isBoardMember();
      allow update: if isBoardMember() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['signups', 'claimedCount']));

      // Private claim records — parents see only their own document.
      // Board members see all. Used for future subcollection-based claiming.
      match /claims/{claimId} {
        allow read: if isBoardMember() ||
          (isSignedIn() && resource.data.parentId == request.auth.uid);
        allow create: if isSignedIn() &&
          request.resource.data.parentId == request.auth.uid;
        allow delete: if isSignedIn() &&
          resource.data.parentId == request.auth.uid;
        allow update: if false; // Claims are immutable — delete and recreate
      }
    }

    // ---------------------------------------------------------------------------
    // Practice Slots
    //
    // Board members: full CRUD.
    // Signed-in users: read all (coaches need to browse available slots).
    // Coaches: may CLAIM an available slot (writes coachId, coachName, teamId,
    //   teamName, teamGameId, status, claimedAt, updatedAt).
    // Coaches: may REQUEST a slot (available → pending) when fairness rules apply.
    // Coaches: may UNCLAIM their own claimed slot (reverts those same fields).
    // Approve (pending → claimed) and deny (pending → available) are board-member only.
    // ---------------------------------------------------------------------------

    match /practiceSlots/{slotId} {
      allow get, list: if isSignedIn();
      allow create, delete: if isBoardMember();
      allow update: if isBoardMember() ||
        // CLAIM: slot must be available, coach writes their own uid
        (isCoach() &&
         resource.data.status == 'available' &&
         request.resource.data.status == 'claimed' &&
         request.resource.data.coachId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['coachId', 'coachName', 'teamId', 'teamName',
                     'status', 'claimedAt', 'teamGameId', 'updatedAt'])) ||
        // PENDING REQUEST: available → pending (coach submits for admin review)
        (isCoach() &&
         resource.data.status == 'available' &&
         request.resource.data.status == 'pending' &&
         request.resource.data.pendingCoachId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'pendingCoachId', 'pendingCoachName', 'pendingTeamId',
                     'pendingTeamName', 'pendingRequestedAt', 'pendingReason', 'updatedAt'])) ||
        // UNCLAIM: coach releases their own claimed slot
        (isCoach() &&
         resource.data.status == 'claimed' &&
         resource.data.coachId == request.auth.uid &&
         request.resource.data.status == 'available' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['coachId', 'coachName', 'teamId', 'teamName',
                     'status', 'claimedAt', 'teamGameId', 'updatedAt']));
    }

    // ---------------------------------------------------------------------------
    // Notifications
    //
    // Users: read their own notifications, and mark them as read.
    // Board members: read all (operational oversight).
    // Create/delete: board members only (system writes via Admin SDK in Cloud Functions).
    // ---------------------------------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if isBoardMember() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isBoardMember() ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow delete: if isBoardMember();
    }

    // ---------------------------------------------------------------------------
    // Other collections
    // ---------------------------------------------------------------------------

    match /sponsors/{sponsorId} {
      allow read, write: if isBoardMember();
    }

    match /announcements/{announcementId} {
      allow get, list: if true; // public — home page shows league announcements
      allow create, update, delete: if isBoardMember();
    }

    match /boardMeetings/{meetingId} {
      allow read, write: if isBoardMember();
    }

    match /inquiries/{inquiryId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || isBoardMember()
      );
      allow create: if
        request.resource.data.status == 'open' &&
        request.resource.data.keys().hasAll(['sport']) &&
        (isSignedIn()
          ? request.resource.data.senderId == request.auth.uid
          : request.resource.data.senderId == null);
      allow update: if isBoardMemberForSport(resource.data.sport);
      allow delete: if isBoardMemberForSport(resource.data.sport);
    }

    match /officers/{officerId} {
      allow read: if true;
      allow write: if isBoardMember();
    }

    // ---------------------------------------------------------------------------
    // Settings — singleton documents (e.g. complexClosures)
    // ---------------------------------------------------------------------------

    match /settings/{settingId} {
      allow read: if true; // public — home page shows complex closure alert
      allow write: if isBoardMember();
    }

    // ---------------------------------------------------------------------------
    // Audit Logs — immutable records written on every admin game mutation.
    // Board members can read and create; no one can update or delete.
    // ---------------------------------------------------------------------------

    match /auditLogs/{logId} {
      allow read: if isBoardMember();
      allow create: if isBoardMember();
      allow update, delete: if false;
    }
  }
}
