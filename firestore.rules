
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'Admin';
    }

    function isCoach() {
      return isSignedIn() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'Coach';
    }

    function isExistingOwner(userId) {
      return resource != null && isUser(userId);
    }

    match /userProfiles/{userId} {
      // Coaches need to read parent profiles to see contact info for their team
      allow get, list: if isUser(userId) || isAdmin() || isCoach();
      allow create: if isUser(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if false;

      match /players/{playerId} {
        allow get, list: if isUser(userId) || isAdmin() || isCoach();
        allow create: if isUser(userId);
        allow update: if isExistingOwner(userId) || isAdmin();
        allow delete: if isExistingOwner(userId) || isAdmin();
      }

      match /enrollments/{enrollmentId} {
        allow get, list: if isUser(userId) || isAdmin() || isCoach();
        allow create: if isUser(userId);
        allow update: if isExistingOwner(userId) || isAdmin();
        allow delete: if isExistingOwner(userId) || isAdmin();
      }
    }

    match /seasons/{seasonId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /divisions/{divisionId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    match /teams/{teamId} {
      allow get, list: if isSignedIn(); 
      allow create: if isAdmin();
      allow update: if isAdmin() || (resource != null && request.auth.uid == resource.data.coachUserId);
      allow delete: if isAdmin();

      match /games/{gameId} {
        allow get, list: if isSignedIn();
        allow create: if isCoach() || isAdmin();
        allow update: if isCoach() || isAdmin();
        allow delete: if isCoach() || isAdmin();

        match /rsvps/{rsvpId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if isSignedIn() || isAdmin();
        }
      }

      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderUserId;
      }
    }
  }
}
