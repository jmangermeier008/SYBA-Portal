rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SHARPSVILLE YOUTH BASEBALL ASSOCIATION (SYBA) - SECURITY RULES
     * 
     * CORE PHILOSOPHY:
     * This ruleset implements a multi-tiered authorization model:
     * 1. Private User Scoping: Personal data (Profiles, Players, Enrollments) is strictly 
     *    scoped to the individual user's UID via path-based ownership.
     * 2. Team Collaboration: Shared resources (Games, Messages, RSVPs) use a Membership Map 
     *    pattern for sensitive data. 
     * 3. Public/League Access: Teams and Games (the schedule) are viewable by all authenticated
     *    members to ensure the league schedule is accessible.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checks if the user has the 'Admin' role in their profile
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'Admin';
    }

    // Shared access check for team-scoped documents (requires denormalized fields)
    function isTeamMember(data) {
      return isSignedIn() && (request.auth.uid == data.coachUserId || request.auth.uid in data.parentUserIds);
    }

    // Robustness helper for updates and deletes
    function isExistingOwner(userId) {
      return resource != null && isUser(userId);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Individual user profiles.
     */
    match /userProfiles/{userId} {
      allow get, list: if isUser(userId) || isAdmin();
      allow create: if isUser(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if false;
    }

    /**
     * @description Players managed by a parent.
     */
    match /userProfiles/{parentUserId}/players/{playerId} {
      allow get, list: if isUser(parentUserId) || isAdmin();
      allow create: if isUser(parentUserId) && request.resource.data.parentUserId == parentUserId;
      allow update: if (isExistingOwner(parentUserId) && request.resource.data.parentUserId == parentUserId) || isAdmin();
      allow delete: if isExistingOwner(parentUserId) || isAdmin();
    }

    /**
     * @description Season enrollments.
     */
    match /userProfiles/{parentUserId}/enrollments/{enrollmentId} {
      allow get, list: if isUser(parentUserId) || isAdmin();
      allow create: if isUser(parentUserId) && request.resource.data.parentUserId == parentUserId;
      allow update: if (isExistingOwner(parentUserId) && request.resource.data.parentUserId == parentUserId) || isAdmin();
      allow delete: if isExistingOwner(parentUserId) || isAdmin();
    }

    /**
     * @description Global season definitions.
     */
    match /seasons/{seasonId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /divisions/{divisionId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    /**
     * @description Team entities and schedules.
     */
    match /teams/{teamId} {
      // Teams and Games are readable by all authenticated league members
      allow get, list: if isSignedIn(); 
      allow create: if isAdmin();
      allow update: if isAdmin() || (resource != null && request.auth.uid == resource.data.coachUserId);
      allow delete: if isAdmin();

      match /games/{gameId} {
        // Schedules are public to all signed-in users
        allow get, list: if isSignedIn();
        allow create: if (isTeamMember(request.resource.data) && request.auth.uid == request.resource.data.coachUserId) || isAdmin();
        allow update: if (isTeamMember(resource.data) && request.auth.uid == resource.data.coachUserId) || isAdmin();
        allow delete: if (isTeamMember(resource.data) && request.auth.uid == resource.data.coachUserId) || isAdmin();

        match /rsvps/{rsvpId} {
          // RSVPs are sensitive; only team members or admins can view attendance
          allow get, list: if isTeamMember(resource.data) || isAdmin();
          allow create: if (isTeamMember(request.resource.data) && isUser(request.resource.data.parentUserId)) || isAdmin();
          allow update: if (isTeamMember(resource.data) && isUser(request.resource.data.parentUserId)) || isAdmin();
          allow delete: if isExistingOwner(resource.data.parentUserId) || isAdmin();
        }
      }

      match /messages/{messageId} {
        // Chat messages are private to team members
        allow get, list: if isTeamMember(resource.data) || isAdmin();
        allow create: if (isTeamMember(request.resource.data) && isUser(request.resource.data.senderUserId)) || isAdmin();
        allow update, delete: if isExistingOwner(resource.data.senderUserId) || isAdmin();
      }
    }

    /**
     * @description Practice drills database.
     */
    match /drills/{drillId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isUser(request.resource.data.creatorUserId);
      allow update: if isExistingOwner(resource.data.creatorUserId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.creatorUserId) || isAdmin();
    }
  }
}