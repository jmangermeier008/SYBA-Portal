
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getUserData();
      let roles = data.get('roles', []);
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             (roles.size() > 0 ? roles.hasAny(['Admin']) : data.role == 'Admin');
    }

    function isBoardMember() {
      let data = getUserData();
      let roles = data.get('roles', []);
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             (roles.size() > 0
               ? roles.hasAny(['Board Member', 'Admin'])
               : data.role == 'Admin');
    }

    function isCoach() {
      let data = getUserData();
      let roles = data.get('roles', []);
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             (roles.size() > 0
               ? roles.hasAny(['Coach', 'Admin'])
               : (data.role == 'Coach' ||
                  (data.role == 'Admin' && data.get('isAlsoCoach', false) == true)));
    }

    // Support for collection group queries
    match /{path=**}/players/{playerId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/enrollments/{enrollmentId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/clearances/{clearanceId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/rsvps/{rsvpId} {
      allow read, write: if isSignedIn();
    }

    match /userProfiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isUser(userId) || isAdmin();
      allow update: if isUser(userId) || isAdmin();
      allow delete: if false;

      match /clearances/{clearanceId} {
        allow read: if isUser(userId) || isAdmin();
        allow create: if isUser(userId) || isAdmin();
        allow update: if isUser(userId) || isAdmin();
        allow delete: if isUser(userId) || isAdmin();
      }

      match /players/{playerId} {
        allow read: if isSignedIn();
        allow create: if isUser(userId) || isAdmin();
        allow update: if isUser(userId) || isAdmin();
        allow delete: if isUser(userId) || isAdmin();
      }

      match /enrollments/{enrollmentId} {
        allow read: if isSignedIn();
        allow create: if isUser(userId) || isAdmin();
        allow update: if isUser(userId) || isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['payment_status', 'paymentStatus', 'stripe_payment_id', 'updatedAt']);
        allow delete: if isUser(userId) || isAdmin();
      }
    }

    match /seasons/{seasonId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isBoardMember();

      match /divisions/{divisionId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isBoardMember();
      }
    }

    // Fields — board members manage, all signed-in users can read for schedule picker
    match /fields/{fieldId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isBoardMember();
    }

    // Concession slots — board members create/delete; signed-in users update signups array
    match /concessionSlots/{slotId} {
      allow get, list: if isSignedIn();
      allow create, delete: if isBoardMember();
      allow update: if isSignedIn();
    }

    // Sponsors — board members only
    match /sponsors/{sponsorId} {
      allow read, write: if isBoardMember();
    }

    // League Announcements — board members write, all signed-in users read
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isBoardMember();
    }

    // Board Meetings — board members only
    match /boardMeetings/{meetingId} {
      allow read, write: if isBoardMember();
    }

    // Games & Practices — board members create/delete; all signed-in users can read
    match /games/{gameId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isBoardMember();
    }

    match /teams/{teamId} {
      allow get, list: if isSignedIn();
      allow create: if isBoardMember();
      allow update: if isBoardMember() || (resource != null && request.auth.uid == resource.data.coach_uid);
      allow delete: if isBoardMember();

      match /games/{gameId} {
        allow get, list: if isSignedIn();
        allow create: if isCoach() || isBoardMember();
        allow update: if isCoach() || isBoardMember();
        allow delete: if isCoach() || isBoardMember();

        match /rsvps/{rsvpId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if isSignedIn() || isBoardMember();
        }
      }

    }
  }
}
