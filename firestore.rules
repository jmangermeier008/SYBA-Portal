rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function isSiteAdmin() {
      let data = getUserData();
      let roles = data.get('roles', []);
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             (data.get('isSiteAdmin', false) == true || roles.hasAny(['Site Admin']));
    }

    function isAdmin() {
      let data = getUserData();
      let roles = data.get('roles', []);
      let sportRoles = data.get('sportRoles', {});
      // Check the sportRoles map (current grant path — the roles admin page
      // writes per-sport grants only), the roles array, and the legacy role
      // field — an empty roles array must not mask a legacy Admin grant.
      return isSiteAdmin() ||
             (isSignedIn() &&
              exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
              (roles.hasAny(['Admin']) || data.get('role', '') == 'Admin' ||
               sportRoles.get('baseball', []).hasAny(['Admin']) ||
               sportRoles.get('football', []).hasAny(['Admin'])));
    }

    function isBoardMember() {
      let data = getUserData();
      let roles = data.get('roles', []);
      let sportRoles = data.get('sportRoles', {});
      return isSiteAdmin() ||
             (isSignedIn() &&
              exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
              (sportRoles.get('baseball', []).hasAny(['Board Member', 'Admin']) ||
               sportRoles.get('football', []).hasAny(['Board Member', 'Admin']) ||
               (roles.size() > 0
                 ? roles.hasAny(['Board Member', 'Admin', 'Site Admin'])
                 : data.get('role', '') == 'Admin')));
    }

    function isBoardMemberForSport(sport) {
      let data = getUserData();
      let sportRoles = data.get('sportRoles', {});
      let rolesForSport = sportRoles.get(sport, []);
      return isSiteAdmin() ||
             (isSignedIn() &&
              exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
              rolesForSport.hasAny(['Board Member', 'Admin']));
    }

    function isCoach() {
      let data = getUserData();
      let roles = data.get('roles', []);
      let sportRoles = data.get('sportRoles', {});
      let baseballRoles = sportRoles.get('baseball', []);
      let footballRoles = sportRoles.get('football', []);
      return isSiteAdmin() ||
             (isSignedIn() &&
              exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
              (baseballRoles.hasAny(['Coach', 'Admin']) ||
               footballRoles.hasAny(['Coach', 'Admin']) ||
               (roles.size() > 0
                 ? roles.hasAny(['Coach', 'Admin'])
                 : (data.get('role', '') == 'Coach' ||
                    (data.get('role', '') == 'Admin' && data.get('isAlsoCoach', false) == true)))));
    }

    // Team-scoped coach check — the requester must be in the team's coachIds.
    // Costs one get() per evaluation; only usable where the doc carries a teamId.
    function isTeamCoach(teamId) {
      return isSignedIn() && teamId is string && teamId != '' &&
        get(/databases/$(database)/documents/teams/$(teamId))
          .data.get('coachIds', []).hasAny([request.auth.uid]);
    }

    // ---------------------------------------------------------------------------
    // Collection group rules — must be at the top level
    // ---------------------------------------------------------------------------

    // Players: board members use collectionGroup for compliance; parents use direct path
    // Secondary parents can read players linked to them via secondaryParentId
    // Coaches read all: their roster pages run an unfiltered collectionGroup query,
    // which a per-team rule cannot prove
    match /{path=**}/players/{playerId} {
      allow read: if isBoardMember() || isCoach() ||
        (isSignedIn() && resource.data.secondaryParentId == request.auth.uid);
    }

    // Enrollments: board members can read all; parents can read their own (filtered by parentUserId)
    // Coaches read all: roster queries use where('teamId','in',...) which per-team
    // get()-based rules cannot prove
    match /{path=**}/enrollments/{enrollmentId} {
      allow read: if isBoardMember() || isCoach() ||
        (isSignedIn() && resource.data.parentUserId == request.auth.uid);
    }

    match /{path=**}/clearances/{clearanceId} {
      allow read: if isBoardMember();
    }

    match /{path=**}/divisions/{divisionId} {
      allow read: if isSignedIn();
    }

    match /{path=**}/rsvps/{rsvpId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.parentUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.parentUserId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.parentUserId == request.auth.uid;
    }

    // ---------------------------------------------------------------------------
    // User Profiles
    // ---------------------------------------------------------------------------

    match /userProfiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      // Self-created profiles can only be plain Parents — elevated roles are
      // granted by Admins after the fact. Prevents a new user creating their
      // own profile pre-set with Admin privileges.
      allow create: if isAdmin() || isSiteAdmin() || (
        isUser(userId) &&
        request.resource.data.get('roles', []).hasOnly(['Parent']) &&
        request.resource.data.get('role', 'Parent') == 'Parent' &&
        request.resource.data.get('isSiteAdmin', false) == false &&
        !('sportRoles' in request.resource.data)
      );
      // Users can update their own profile but cannot change their own roles
      // or grant themselves coach access (complianceStatus gates the coach
      // portal). Role/permission changes require Admin or Site Admin.
      allow update: if (isUser(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles', 'isSiteAdmin', 'sportRoles', 'complianceStatus', 'manualComplianceOverride'])
        ) ||
        // Board Members review clearances, so they may sync the compliance
        // gate on other profiles — but touch nothing else.
        (isBoardMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complianceStatus', 'updatedAt'])) ||
        isAdmin() || isSiteAdmin();
      allow delete: if isAdmin() || isSiteAdmin();

      match /clearances/{clearanceId} {
        // Board Members + Admins audit volunteer clearances (matches the registration page UI)
        allow read: if isUser(userId) || isBoardMember();
        allow create: if isUser(userId) || isAdmin();
        allow update: if isUser(userId) || isBoardMember();
        allow delete: if isUser(userId) || isAdmin();
      }

      match /players/{playerId} {
        allow read: if isUser(userId) || isBoardMember() ||
          (isSignedIn() && resource.data.secondaryParentId == request.auth.uid);
        allow create: if isUser(userId) || isAdmin();
        allow update: if isUser(userId) || isAdmin() ||
          (isSignedIn() && resource.data.secondaryParentId == request.auth.uid) ||
          (isBoardMember() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ageVerified', 'compliance', 'dateOfBirth', 'divisionId',
                      'verifiedBy', 'verifiedByName', 'verifiedAt', 'updatedAt']));
        allow delete: if isUser(userId) || isAdmin() || isSiteAdmin();
      }

      match /enrollments/{enrollmentId} {
        allow read: if isUser(userId) || isBoardMember();
        // Parents may only create enrollments that are not yet paid — payment
        // fields are set exclusively by the server (Stripe webhook/confirm).
        allow create: if isAdmin() || (
          isUser(userId) &&
          request.resource.data.get('paymentStatus', 'pending_payment') in ['pending_payment', 'waitlisted'] &&
          request.resource.data.get('payment_status', 'pending_payment') in ['pending_payment', 'waitlisted'] &&
          request.resource.data.get('stripe_payment_id', '') == ''
        );
        allow update: if (
          // Parent can update their own enrollment but not payment status, sport, or admin-only equipment fields
          (isUser(userId) &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['payment_status', 'paymentStatus', 'stripe_payment_id', 'footballEquipment', 'sport']))
          ) ||
          // Admins have full update access
          isAdmin() ||
          // Board members (sport-scoped) can update equipment fields only
          (isBoardMemberForSport(resource.data.sport) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['footballEquipment'])) ||
          // The player's team coach can record weigh-ins and issue/return equipment
          (isCoach() && isTeamCoach(resource.data.get('teamId', '')) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['weightHistory', 'footballEquipment']));
        // Parents may not delete paid/waived enrollments — that would destroy
        // the payment record. Admins and board members handle refunds.
        allow delete: if isAdmin() || isBoardMember() || (
          isUser(userId) &&
          !(resource.data.get('paymentStatus', '') in ['paid', 'fee_waived']) &&
          !(resource.data.get('payment_status', '') in ['paid', 'fee_waived'])
        );
      }

      // Per-device web-push registration tokens (doc ID = FCM token).
      // Owner-only: tokens are device credentials and must never be readable
      // by other signed-in users. Server-side sends and dead-token pruning
      // use the Admin SDK, which bypasses rules.
      match /pushTokens/{tokenId} {
        allow read, write: if isUser(userId);
      }
    }

    // ---------------------------------------------------------------------------
    // System config (e.g. runtime Stripe mode)
    // ---------------------------------------------------------------------------
    // Reads allowed for admins (UI surfacing). All writes go through the Admin SDK
    // (server route), which bypasses these rules — clients can never set the mode.
    match /systemConfig/{doc} {
      allow read: if isSiteAdmin() || isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------------
    // Seasons & Divisions
    // ---------------------------------------------------------------------------

    match /seasons/{seasonId} {
      allow get, list: if true; // public — home page shows registration banner
      allow create: if isBoardMember() &&
        request.resource.data.sport is string;
      allow update, delete: if isBoardMember();

      match /divisions/{divisionId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isBoardMember();
      }
    }

    // ---------------------------------------------------------------------------
    // Fields — Site Admin manages; all signed-in users read
    // ---------------------------------------------------------------------------

    match /fields/{fieldId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isBoardMember();
    }

    // ---------------------------------------------------------------------------
    // Games & Practices — board members manage; all signed-in users read
    // ---------------------------------------------------------------------------

    match /games/{gameId} {
      allow get, list: if true; // public — home page shows this week's schedule
      allow create: if (isBoardMember() &&
        request.resource.data.sport is string) ||
        // Football coaches may schedule practices for their own team
        (isCoach() &&
         request.resource.data.get('sport', '') == 'football' &&
         request.resource.data.get('type', '') == 'practice' &&
         isTeamCoach(request.resource.data.get('teamId', '')));
      allow update: if (isBoardMember() &&
        request.resource.data.sport is string) ||
        // Football coaches may log the final score for their own team's games
        (isCoach() &&
         resource.data.get('sport', '') == 'football' &&
         resource.data.get('type', '') == 'game' &&
         isTeamCoach(resource.data.get('teamId', '')) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['homeScore', 'awayScore', 'status', 'updatedAt']) &&
         request.resource.data.status == 'completed');
      allow delete: if isBoardMember();
    }

    match /teams/{teamId} {
      allow get, list: if isSignedIn();
      allow create: if isBoardMember() &&
        request.resource.data.sport is string;
      allow update: if isBoardMember() || (resource != null && request.auth.uid == resource.data.coach_uid);
      allow delete: if isBoardMember();

      match /games/{gameId} {
        allow get, list: if isSignedIn();
        allow create: if isCoach() || isBoardMember();
        allow update: if isBoardMember() ||
          (isCoach() &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['homeScore', 'awayScore', 'status', 'attendance',
                       'cancelled', 'cancellationReason', 'updatedAt']));
        allow delete: if isBoardMember();

        match /rsvps/{rsvpId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.parentUserId == request.auth.uid;
          allow update: if isSignedIn() && resource.data.parentUserId == request.auth.uid;
          allow delete: if (isSignedIn() && resource.data.parentUserId == request.auth.uid) || isBoardMember();
        }
      }
    }

    // ---------------------------------------------------------------------------
    // Concession Slots
    //
    // Board members: full CRUD.
    // Signed-in users: read all slots (to see availability).
    // Parents: may only update the `signups` array field via transaction.
    //   All other fields (capacity, dates, etc.) are board-member-only.
    // ---------------------------------------------------------------------------

    match /concessionSlots/{slotId} {
      allow get, list: if isSignedIn();
      allow create, delete: if isBoardMember();
      allow update: if isBoardMember() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['signups', 'claimedCount']));

      // Private claim records — parents see only their own document.
      // Board members see all. Used for future subcollection-based claiming.
      match /claims/{claimId} {
        allow read: if isBoardMember() ||
          (isSignedIn() && resource.data.parentId == request.auth.uid);
        allow create: if isSignedIn() &&
          request.resource.data.parentId == request.auth.uid;
        allow delete: if isSignedIn() &&
          resource.data.parentId == request.auth.uid;
        allow update: if false; // Claims are immutable — delete and recreate
      }
    }

    // ---------------------------------------------------------------------------
    // Custom Events (generic calendar events — meetings, picture day, fundraisers)
    //
    // Any signed-in user may read; visibility is enforced client-side.
    // Board members (incl. admins) and coaches may create/update.
    // Board members may delete any; coaches may delete only events they created.
    // ---------------------------------------------------------------------------

    match /customEvents/{eventId} {
      allow get, list: if isSignedIn();
      allow create, update: if isBoardMember() || isCoach();
      allow delete: if isBoardMember() ||
        (isSignedIn() && resource.data.createdByUid == request.auth.uid);
    }

    // ---------------------------------------------------------------------------
    // Practice Slots
    //
    // Board members: full CRUD.
    // Signed-in users: read all (coaches need to browse available slots).
    // Coaches: may CLAIM an available slot (writes coachId, coachName, teamId,
    //   teamName, teamGameId, status, claimedAt, updatedAt).
    // Coaches: may REQUEST a slot (available → pending) when fairness rules apply.
    // Coaches: may UNCLAIM their own claimed slot (reverts those same fields).
    // Approve (pending → claimed) and deny (pending → available) are board-member only.
    // ---------------------------------------------------------------------------

    match /practiceSlots/{slotId} {
      allow get, list: if isSignedIn();
      allow create, delete: if isBoardMember();
      allow update: if isBoardMember() ||
        // CLAIM: slot must be available, coach writes their own uid
        (isCoach() &&
         resource.data.status == 'available' &&
         request.resource.data.status == 'claimed' &&
         request.resource.data.coachId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['coachId', 'coachName', 'teamId', 'teamName',
                     'status', 'claimedAt', 'teamGameId', 'updatedAt'])) ||
        // PENDING REQUEST: available → pending (coach submits for admin review)
        (isCoach() &&
         resource.data.status == 'available' &&
         request.resource.data.status == 'pending' &&
         request.resource.data.pendingCoachId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'pendingCoachId', 'pendingCoachName', 'pendingTeamId',
                     'pendingTeamName', 'pendingRequestedAt', 'pendingReason', 'updatedAt'])) ||
        // UNCLAIM: coach releases their own claimed slot
        (isCoach() &&
         resource.data.status == 'claimed' &&
         resource.data.coachId == request.auth.uid &&
         request.resource.data.status == 'available' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['coachId', 'coachName', 'teamId', 'teamName',
                     'status', 'claimedAt', 'teamGameId', 'updatedAt']));
    }

    // ---------------------------------------------------------------------------
    // Notifications
    //
    // Users: read their own notifications, and mark them as read.
    // Board members: read all (operational oversight).
    // Create/delete: board members only (system writes via Admin SDK in Cloud Functions).
    // ---------------------------------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if isBoardMember() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isBoardMember() ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        // Coaches fan out activity pings (to admins), team-facing notifications
        // (announcements, weather cancellations, RSVP nudges), and parent-facing
        // equipment issue/return notices
        (isCoach() && request.resource.data.get('type', '') in
          ['coachActivity', 'announcement', 'gameCancelled', 'rsvpNudge', 'equipment']);
      allow delete: if isBoardMember();
    }

    // ---------------------------------------------------------------------------
    // Other collections
    // ---------------------------------------------------------------------------

    match /equipmentInventory/{itemId} {
      allow read: if isBoardMember() || isCoach();
      allow create, delete: if isBoardMember();
      // Coaches may issue/return items at the field — assignment fields only,
      // never the item's identity (type, size, tag number)
      allow update: if isBoardMember() ||
        (isCoach() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'issuedToPlayerId', 'issuedToParentUserId',
                    'issuedToEnrollmentId', 'issuedAt', 'issuedByUid',
                    'issuedByName', 'returnedAt']));

      // Append-only audit log of issue/return/retire/restore events. Coaches
      // write events when issuing/returning at the field, always self-attributed.
      // Board delete exists only so deleting an item can clean up its history.
      match /history/{eventId} {
        allow read: if isBoardMember() || isCoach();
        allow create: if isBoardMember() ||
          (isCoach() && request.resource.data.get('actorUid', '') == request.auth.uid);
        allow update: if false;
        allow delete: if isBoardMember();
      }
    }

    // Admin-managed equipment type registry: doc id = type slug, label is the
    // display name (standard types get a doc only when their label is renamed)
    match /equipmentTypes/{slug} {
      allow read: if isBoardMember() || isCoach();
      allow write: if isBoardMember();
    }

    match /sponsors/{sponsorId} {
      allow read, write: if isBoardMember();
    }

    match /announcements/{announcementId} {
      allow get, list: if true; // public — home page shows league announcements
      // Coaches may post team-scoped announcements only: teamId required, no
      // league-wide flags, and always attributed to themselves
      allow create: if isBoardMember() ||
        (isCoach() &&
         isTeamCoach(request.resource.data.get('teamId', '')) &&
         request.resource.data.sport is string &&
         request.resource.data.get('createdByUid', '') == request.auth.uid &&
         request.resource.data.get('isGlobal', false) == false &&
         request.resource.data.get('isUrgent', false) == false &&
         request.resource.data.get('pinned', false) == false);
      allow update: if isBoardMember() ||
        (isCoach() &&
         resource.data.get('createdByUid', '') == request.auth.uid &&
         isTeamCoach(resource.data.get('teamId', '')) &&
         // A team post must stay a team post — no re-scoping or promotion
         request.resource.data.get('teamId', '') == resource.data.get('teamId', '') &&
         request.resource.data.get('createdByUid', '') == request.auth.uid &&
         request.resource.data.get('isGlobal', false) == false &&
         request.resource.data.get('isUrgent', false) == false &&
         request.resource.data.get('pinned', false) == false);
      allow delete: if isBoardMember() ||
        (isCoach() &&
         resource.data.get('createdByUid', '') == request.auth.uid &&
         isTeamCoach(resource.data.get('teamId', '')));
    }

    match /boardMeetings/{meetingId} {
      allow read, write: if isBoardMember();
    }

    match /inquiries/{inquiryId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || isBoardMember()
      );
      allow create: if
        request.resource.data.status == 'open' &&
        request.resource.data.keys().hasAll(['sport']) &&
        (isSignedIn()
          ? request.resource.data.senderId == request.auth.uid
          : request.resource.data.senderId == null);
      allow update: if isBoardMemberForSport(resource.data.sport);
      allow delete: if isBoardMemberForSport(resource.data.sport);
    }

    match /officers/{officerId} {
      allow read: if true;
      allow write: if isBoardMember();
    }

    // ---------------------------------------------------------------------------
    // Settings — singleton documents (e.g. complexClosures)
    // ---------------------------------------------------------------------------

    match /settings/{settingId} {
      allow read: if true; // public — home page shows complex closure alert
      allow write: if isBoardMember();
    }

    // ---------------------------------------------------------------------------
    // Link Requests — co-parent access requests (no admin involvement)
    //
    // Create: the requesting parent creates the document (server action verifies).
    // Read:   the requesting parent sees their own request; target parents see requests
    //         addressed to them.
    // Update: only target parents (the existing parent) can approve or deny.
    // ---------------------------------------------------------------------------

    match /linkRequests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.requestingParentUid == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.requestingParentUid == request.auth.uid ||
        request.auth.uid in resource.data.targetParentUids
      );
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.targetParentUids &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Audit Logs — immutable records written on every admin game mutation.
    // Board members can read and create; no one can update or delete.
    // ---------------------------------------------------------------------------

    match /auditLogs/{logId} {
      allow read: if isBoardMember();
      allow create: if isBoardMember();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Claim Failures — written when a paid anonymous user fails to claim their
    // account (e.g. email already in use) so an admin can reassign the enrollment.
    // ---------------------------------------------------------------------------

    match /claimFailures/{failureId} {
      allow create: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid;
      allow read: if isAdmin() || isBoardMember();
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Payment Events — webhook audit trail written by the server (Admin SDK).
    // Read-only payment health visibility for admins and board members.
    // ---------------------------------------------------------------------------

    match /paymentEvents/{eventId} {
      allow read: if isAdmin() || isBoardMember();
      // Events are written exclusively by the Stripe webhook (Admin SDK).
      // Admins may only mark an event as resolved/dismissed from the
      // payments-health page — never alter the event itself.
      allow create, delete: if false;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvedAt', 'resolvedBy']);
    }

    // ---------------------------------------------------------------------------
    // Calendar Tokens — the doc ID is the secret credential for a user's
    // subscribable ICS feed. Admin SDK only; any client read would leak every
    // family's feed URL.
    // ---------------------------------------------------------------------------

    match /calendarTokens/{token} {
      allow read, write: if false;
    }
  }
}
