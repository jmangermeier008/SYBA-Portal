
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile within the Home Run Hub application, storing their identity and assigned role.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity. This typically corresponds to the Firebase Authentication UID."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "The user's full name."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Primary contact phone number for the parent."
        },
        "role": {
          "type": "string",
          "description": "The user's assigned role ('Parent', 'Coach', 'Admin')."
        },
        "shareContactInfo": {
          "type": "boolean",
          "description": "Privacy setting: Whether to share contact details with team members.",
          "default": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "role"
      ]
    },
    "Player": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Player",
      "type": "object",
      "description": "Represents a player managed by a parent.",
      "properties": {
        "id": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date"
        },
        "medicalNotes": {
          "type": "string",
          "description": "Critical medical alerts (allergies, etc.)."
        },
        "parentUserId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "dateOfBirth",
        "parentUserId"
      ]
    },
    "Enrollment": {
      "title": "Enrollment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "playerId": { "type": "string" },
        "seasonId": { "type": "string" },
        "divisionId": { "type": "string" },
        "jerseySize": { "type": "string" },
        "jerseyNumber": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid"] },
        "teamId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "User profiles and roles."
        }
      },
      {
        "path": "/userProfiles/{userId}/players/{playerId}",
        "definition": {
          "entityName": "Player",
          "schema": {
            "$ref": "#/backend/entities/Player"
          },
          "description": "Players managed by a parent."
        }
      },
      {
        "path": "/userProfiles/{userId}/enrollments/{enrollmentId}",
        "definition": {
          "entityName": "Enrollment",
          "description": "Season enrollments."
        }
      }
    ]
  }
}
