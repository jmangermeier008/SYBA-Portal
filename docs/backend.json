
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile within the Home Run Hub application, storing their identity and assigned role.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity. This typically corresponds to the Firebase Authentication UID."
        },
        "email": {
          "type": "string",
          "description": "The user's email address, primarily used for authentication and contact.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "The user's full name."
        },
        "role": {
          "type": "string",
          "description": "The user's assigned role within the application (e.g., 'Parent', 'Coach', 'Admin')."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the user profile was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the user profile was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "Player": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Player",
      "type": "object",
      "description": "Represents a player managed by a parent, including personal details and linked documents.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Player entity."
        },
        "firstName": {
          "type": "string",
          "description": "The player's first name."
        },
        "lastName": {
          "type": "string",
          "description": "The player's last name."
        },
        "dateOfBirth": {
          "type": "string",
          "description": "The player's date of birth.",
          "format": "date"
        },
        "parentUserId": {
          "type": "string",
          "description": "Reference to the UserProfile of the parent who manages this player."
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "dateOfBirth",
        "parentUserId"
      ]
    },
    "Season": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Season",
      "type": "object",
      "description": "Defines a specific playing season.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Season entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the season (e.g., 'Spring 2024')."
        },
        "registrationOpen": {
          "type": "string",
          "format": "date"
        },
        "registrationClose": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Division": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Division",
      "type": "object",
      "description": "Represents a specific playing division within a season.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Division entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the division (e.g., 'T-Ball')."
        },
        "fee": {
          "type": "number",
          "description": "The registration fee amount in cents."
        }
      },
      "required": [
        "id",
        "name",
        "fee"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "User profiles and roles."
        }
      },
      {
        "path": "/userProfiles/{userId}/players/{playerId}",
        "definition": {
          "entityName": "Player",
          "schema": {
            "$ref": "#/backend/entities/Player"
          },
          "description": "Players managed by a parent."
        }
      },
      {
        "path": "/seasons/{seasonId}",
        "definition": {
          "entityName": "Season",
          "schema": {
            "$ref": "#/backend/entities/Season"
          },
          "description": "Global playing seasons."
        }
      },
      {
        "path": "/seasons/{seasonId}/divisions/{divisionId}",
        "definition": {
          "entityName": "Division",
          "schema": {
            "$ref": "#/backend/entities/Division"
          },
          "description": "Divisions within a season."
        }
      }
    ]
  }
}
